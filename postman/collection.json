
{
  "info": {
    "name": "Student Management System API",
    "description": "Postman collection for testing authentication, API Gateway, student CRUD, course CRUD, and student enrollment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health Checks",
      "item": [
        {
          "name": "API Gateway Health",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8000/health",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Auth Service Health",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8001/health",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Student Service Health",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8002/health",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Course Service Health",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8003/health",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8000/auth/register",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postmanuser\",\n  \"email\": \"postmanuser@example.com\",\n  \"password\": \"PostmanTest@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.access_token) {",
                  "        pm.collectionVariables.set('token', data.access_token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8000/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"studenttest2@example.com\",\n  \"password\": \"StudentTest@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8000/auth/me"
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Get All Students",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8000/students"
          }
        },
        {
          "name": "Get Student by ID",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8000/students/1"
          }
        },
        {
          "name": "Create Student",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8000/students",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Student\",\n  \"email\": \"postman.student@example.com\",\n  \"phone_number\": \"9876501234\",\n  \"department\": \"Computer Science\",\n  \"course\": \"B.Tech\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update Student",
          "request": {
            "method": "PUT",
            "url": "http://127.0.0.1:8000/students/1",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Test Student\",\n  \"email\": \"postman.student@example.com\",\n  \"phone_number\": \"9876501234\",\n  \"department\": \"Information Technology\",\n  \"course\": \"B.Tech\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete Student",
          "request": {
            "method": "DELETE",
            "url": "http://127.0.0.1:8000/students/1"
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Get All Courses",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8000/courses"
          }
        },
        {
          "name": "Get Course by ID",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8000/courses/1"
          }
        },
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8000/courses",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Testing Course\",\n  \"code\": \"PT101\",\n  \"description\": \"Course created for API testing\",\n  \"duration\": \"8 weeks\",\n  \"department\": \"Computer Science\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update Course",
          "request": {
            "method": "PUT",
            "url": "http://127.0.0.1:8000/courses/1",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Testing Course\",\n  \"code\": \"PT101\",\n  \"description\": \"Updated course details\",\n  \"duration\": \"10 weeks\",\n  \"department\": \"Information Technology\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete Course",
          "request": {
            "method": "DELETE",
            "url": "http://127.0.0.1:8000/courses/1"
          }
        }
      ]
    },
    {
      "name": "Enrollments",
      "item": [
        {
          "name": "Enroll Student in Course",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8000/courses/1/enrollments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": 1,\n  \"course_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get Students Enrolled in Course",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8000/courses/1/students"
          }
        },
        {
          "name": "Test Duplicate Enrollment",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8000/courses/1/enrollments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": 1,\n  \"course_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
}
